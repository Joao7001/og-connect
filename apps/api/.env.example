PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/grupo-plus
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
# Optional fallback when the local DNS blocks MongoDB SRV lookups.
DNS_SERVERS=1.1.1.1,8.8.8.8
# Cloudinary unsigned upload configuration for production image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Optional live stream integrations. Keep these only in apps/api/.env, never in the frontend.
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
